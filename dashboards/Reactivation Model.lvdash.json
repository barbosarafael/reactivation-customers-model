{
  "datasets": [
    {
      "name": "latest_summary",
      "displayName": "latest_summary",
      "queryLines": [
        "SELECT\n",
        "          CAST(scoring_date AS STRING) AS latest_scoring_date,\n",
        "          CAST(overall_status AS STRING) AS overall_status,\n",
        "          CAST(number_customers AS BIGINT) AS number_customers,\n",
        "          CAST(score_mean AS DOUBLE) AS score_mean,\n",
        "          CAST(predicted_positive_rate AS DOUBLE) AS predicted_positive_rate,\n",
        "          CAST(maximum_feature_psi AS DOUBLE) AS maximum_feature_psi,\n",
        "          CAST(model_version AS STRING) AS model_version,\n",
        "          CAST(target_status AS STRING) AS target_status,\n",
        "          CAST(scenario AS STRING) AS scenario\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "        ORDER BY scoring_date DESC\n",
        "        LIMIT 1\n"
      ]
    },
    {
      "name": "population_trend",
      "displayName": "population_trend",
      "queryLines": [
        "SELECT\n",
        "          scoring_date,\n",
        "          CAST(number_customers AS BIGINT) AS number_customers\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "        ORDER BY scoring_date\n"
      ]
    },
    {
      "name": "score_trend",
      "displayName": "score_trend",
      "queryLines": [
        "SELECT\n",
        "          scoring_date,\n",
        "          'Score médio' AS metric_name,\n",
        "          CAST(score_mean AS DOUBLE) AS metric_value\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "\n",
        "        UNION ALL\n",
        "\n",
        "        SELECT\n",
        "          scoring_date,\n",
        "          'Score mediano' AS metric_name,\n",
        "          CAST(score_median AS DOUBLE) AS metric_value\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "\n",
        "        UNION ALL\n",
        "\n",
        "        SELECT\n",
        "          scoring_date,\n",
        "          'Percentil 90' AS metric_name,\n",
        "          CAST(score_p90 AS DOUBLE) AS metric_value\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n"
      ]
    },
    {
      "name": "latest_score_distribution",
      "displayName": "latest_score_distribution",
      "queryLines": [
        "SELECT\n",
        "          CAST(\n",
        "            FLOOR(\n",
        "              CAST(reactivation_probability AS DOUBLE) * 20\n",
        "            ) / 20\n",
        "            AS DOUBLE\n",
        "          ) AS score_bin,\n",
        "          COUNT(*) AS number_customers\n",
        "        FROM workspace.gold_layer.customer_reactivation_scoring\n",
        "        WHERE scoring_date = (\n",
        "          SELECT MAX(scoring_date)\n",
        "          FROM workspace.gold_layer.customer_reactivation_scoring\n",
        "        )\n",
        "        GROUP BY\n",
        "          CAST(\n",
        "            FLOOR(\n",
        "              CAST(reactivation_probability AS DOUBLE) * 20\n",
        "            ) / 20\n",
        "            AS DOUBLE\n",
        "          )\n",
        "        ORDER BY score_bin\n"
      ]
    },
    {
      "name": "priority_groups",
      "displayName": "priority_groups",
      "queryLines": [
        "SELECT\n",
        "          scoring_date,\n",
        "          'TOP_10' AS priority_group,\n",
        "          CAST(top_10_customers AS BIGINT) AS number_customers\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "\n",
        "        UNION ALL\n",
        "\n",
        "        SELECT\n",
        "          scoring_date,\n",
        "          'TOP_20' AS priority_group,\n",
        "          CAST(top_20_customers AS BIGINT) AS number_customers\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "\n",
        "        UNION ALL\n",
        "\n",
        "        SELECT\n",
        "          scoring_date,\n",
        "          'TOP_30' AS priority_group,\n",
        "          CAST(top_30_customers AS BIGINT) AS number_customers\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "\n",
        "        UNION ALL\n",
        "\n",
        "        SELECT\n",
        "          scoring_date,\n",
        "          'REMAINDER' AS priority_group,\n",
        "          CAST(remainder_customers AS BIGINT) AS number_customers\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n"
      ]
    },
    {
      "name": "latest_feature_psi",
      "displayName": "latest_feature_psi",
      "queryLines": [
        "SELECT\n",
        "          CAST(feature_name AS STRING) AS feature_name,\n",
        "          CAST(psi AS DOUBLE) AS psi,\n",
        "          CAST(status AS STRING) AS status\n",
        "        FROM workspace.monitoring_layer.feature_monitoring\n",
        "        WHERE scoring_date = (\n",
        "          SELECT MAX(scoring_date)\n",
        "          FROM workspace.monitoring_layer.feature_monitoring\n",
        "        )\n",
        "        ORDER BY psi DESC\n"
      ]
    },
    {
      "name": "drift_trend",
      "displayName": "drift_trend",
      "queryLines": [
        "SELECT\n",
        "          scoring_date,\n",
        "          'Maior PSI de feature' AS drift_name,\n",
        "          CAST(maximum_feature_psi AS DOUBLE) AS psi\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "\n",
        "        UNION ALL\n",
        "\n",
        "        SELECT\n",
        "          scoring_date,\n",
        "          'PSI dos scores' AS drift_name,\n",
        "          CAST(score_psi AS DOUBLE) AS psi\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n"
      ]
    },
    {
      "name": "data_quality",
      "displayName": "data_quality",
      "queryLines": [
        "SELECT\n",
        "          CAST(scoring_date AS STRING) AS scoring_date,\n",
        "          CAST(scenario AS STRING) AS scenario,\n",
        "          CAST(batch_rows AS STRING) AS batch_rows,\n",
        "          CAST(null_rows AS STRING) AS null_rows,\n",
        "          CAST(duplicate_rows AS STRING) AS duplicate_rows,\n",
        "          CAST(invalid_price_rows AS STRING) AS invalid_price_rows,\n",
        "          CAST(invalid_quantity_rows AS STRING) AS invalid_quantity_rows,\n",
        "          CAST(dq_status AS STRING) AS dq_status,\n",
        "          CAST(overall_status AS STRING) AS overall_status\n",
        "        FROM workspace.monitoring_layer.model_monitoring_summary\n",
        "        ORDER BY scoring_date DESC\n"
      ]
    }
  ],
